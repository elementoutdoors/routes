{
  "_about": "How written text is said aloud. The screen keeps the written text; these rules only change what the natural voice and the phone voice say. rules: find (a regular expression), say (what to say instead), langs (which languages it applies to). names: how to say a place name the voice gets wrong, as a respelling (for example \"Tinbeerwah\": \"Tin-beer-wah\"); used in every language. Changing a rule re-records only the lines it changes.",
  "rules": [
    { "find": "\\bMt\\.? (?=[A-Z])", "say": "Mount ", "langs": ["en", "de", "fr", "es", "it", "nl"] },
    { "find": "\\bRd\\b", "say": "Road", "langs": ["en"] },
    { "find": "\\brd\\b", "say": "road", "langs": ["en"] },
    { "find": "([A-Z][A-Za-z']+) St\\b(?!\\.? [A-Z][a-z])", "say": "$1 Street", "langs": ["en"] },
    { "find": "([A-Z][A-Za-z']+) Dr\\b(?!\\.? [A-Z])", "say": "$1 Drive", "langs": ["en"] },
    { "find": "\\bHwy\\b", "say": "Highway", "langs": ["en"] },
    { "find": "\\bAve\\b", "say": "Avenue", "langs": ["en"] },
    { "find": "\\bTce\\b", "say": "Terrace", "langs": ["en"] },
    { "find": "(\\d)\\s?km/h\\b", "say": "$1 kilometres an hour", "langs": ["en"] },
    { "find": "(\\d)\\s?km\\b", "say": "$1 kilometres", "langs": ["en"] },
    { "find": "(\\d)\\s?m\\b", "say": "$1 metres", "langs": ["en"] },
    { "find": "\\bMTB\\b", "say": "mountain bike", "langs": ["en"] },
    { "find": " & ", "say": " and ", "langs": ["en"] },
    { "find": "\\b(\\d+)/(\\d+) (?=[A-Z])", "say": "$2 ", "langs": ["en", "de", "fr", "es", "it", "nl"] },
    { "find": " ?[—–] ?", "say": ", ", "langs": ["en", "de", "fr", "es", "it", "nl"] },
    { "find": "([^.!?:;,\\s])[ \\t]*\\n+", "say": "$1. ", "langs": ["en", "de", "fr", "es", "it", "nl"] },
    { "find": "([^。！？：；，\\s])[ \\t]*\\n+", "say": "$1。", "langs": ["zh", "ja"] },
    { "find": "([^.!?:;,\\s])[ \\t]*\\n+", "say": "$1. ", "langs": ["ko"] },
    { "find": "\\s*\\n+\\s*", "say": " ", "langs": ["en", "de", "fr", "es", "it", "nl", "zh", "ja", "ko"] }
  ],
  "names": {}
}
